{
  "$schema": "vscode://schemas/color-theme",
  "name": "Mensa GitHub Dark",
  "include": "../../_base/github-dark-default.json",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#6A7FC4",
    "activityBar.background": "#2C3E7A",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.border": "#1F2C56",
    "activityBar.activeBorder": "#6A7FC4",
    "activityBarBadge.background": "#405BB3",
    "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#2C3E7A",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#1F2C56",
    "titleBar.inactiveForeground": "#8999D0",
    "titleBar.border": "#1F2C56",
    "statusBar.background": "#405BB3",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#6A7FC4",
    "statusBar.noFolderBackground": "#2C3E7A",
    "statusBar.noFolderForeground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#6A7FC433",
    "menubar.selectionBackground": "#405BB333",
    "menubar.selectionForeground": "#FFFFFF",
    "menu.selectionBackground": "#405BB333",
    "menu.selectionForeground": "#FFFFFF",
    "menu.border": "#1F2C56",
    "commandCenter.activeBackground": "#405BB330",
    "commandCenter.activeForeground": "#FFFFFF",
    "notificationCenterHeader.background": "#2C3E7A",
    "notificationCenterHeader.foreground": "#FFFFFF",
    "notifications.background": "#191D2B",
    "notifications.foreground": "#FFFFFF",
    "notifications.border": "#405BB3",
    "panel.border": "#1F2C56",
    "sideBar.border": "#1F2C56",
    "editorGroup.border": "#1F2C56",
    "pickerGroup.border": "#405BB3",
    "inputOption.activeBorder": "#6A7FC4",
    "badge.background": "#405BB3",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#6A7FC4",
    "toolbar.hoverBackground": "#405BB322",
    "toolbar.activeBackground": "#405BB333",
    "diffEditor.removedLineBackground": "#D6A1FF1F",
    "diffEditor.removedTextBackground": "#D6A1FF44",
    "diffEditorGutter.removedLineBackground": "#D6A1FF66",
    "diffEditor.insertedLineBackground": "#96FFBB1F",
    "diffEditor.insertedTextBackground": "#96FFBB44",
    "diffEditorGutter.insertedLineBackground": "#96FFBB66"
  },
  "tokenColors": [
    {
      "name": "Language syntax",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.word",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#91FFBF"
      }
    },
    {
      "name": "Literal values",
      "scope": [
        "string",
        "string.quoted",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#FFC696"
      }
    },
    {
      "name": "Links (Markdown + source)",
      "scope": [
        "string.other.link.title.markdown",
        "meta.link.reference.markdown",
        "meta.link.reference.def.markdown",
        "meta.link.inline.markdown",
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#A1DDFF"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "comment.block.html"
      ],
      "settings": {
        "foreground": "#A6E6F5"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#91FFBF",
    "string": "#FFC696",
    "number": "#FFC696",
    "comment": "#A6E6F5"
  }
}
